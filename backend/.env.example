# ========================================
# DISCOVERY SYSTEMS POS - ENVIRONMENT VARIABLES
# ========================================

# -------------------- DATABASE --------------------
DATABASE_URL=postgresql://usuario:password@host:5432/discovery_pos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=discovery_pos
DB_USER=postgres
DB_PASSWORD=tu_password_seguro

# -------------------- SERVER --------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# -------------------- ANTHROPIC (CLAUDE AI) --------------------
# Obtener API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------- WHATSAPP (WAHA) --------------------
# WAHA (WhatsApp HTTP API) - API no oficial
# Documentación: https://waha.devlike.pro/
WAHA_URL=http://localhost:3000
WAHA_API_KEY=tu_api_key_waha
WAHA_SESSION=default

# Número de WhatsApp de Discovery Systems (formato internacional sin +)
DISCOVERY_WHATSAPP=573001234567

# -------------------- PDF GENERATION --------------------
# URL pública donde se hospedan los PDFs (Railway auto-genera esto)
PUBLIC_URL=https://tu-app.railway.app

# -------------------- CALENDLY --------------------
# Para integración de agendamiento (opcional)
CALENDLY_API_KEY=tu_calendly_api_key
CALENDLY_USER_URL=https://calendly.com/discovery-systems

# -------------------- ANALYTICS --------------------
# Google Analytics (opcional)
GA_TRACKING_ID=G-XXXXXXXXXX

# -------------------- SECURITY --------------------
JWT_SECRET=tu_jwt_secret_super_seguro_cambiar_en_produccion
SESSION_SECRET=otra_clave_secreta_para_sessions

# CORS allowed origins (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://tu-dominio.com

# -------------------- EMAIL (OPCIONAL) --------------------
# Para notificaciones por email (Resend, SendGrid, etc.)
EMAIL_FROM=noreply@discoverysystems.co
EMAIL_SERVICE=resend
EMAIL_API_KEY=re_xxxxxxxxxx

# -------------------- RATE LIMITING --------------------
# Límites para proteger la API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting específico para IA (para controlar costos)
AI_RATE_LIMIT_MAX_PER_DAY=100
AI_RATE_LIMIT_MAX_PER_LEAD=10

# -------------------- REDIS (OPCIONAL) --------------------
# Para cache y queues (opcional pero recomendado en producción)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# -------------------- SENTRY (OPCIONAL) --------------------
# Para tracking de errores en producción
SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx

# -------------------- FEATURE FLAGS --------------------
# Activar/desactivar features
FEATURE_AI_WIZARD=true
FEATURE_AI_CHATBOT=true
FEATURE_AI_QUOTE_GENERATION=true
FEATURE_WHATSAPP_AUTO_SEND=true
FEATURE_ANALYTICS=true

# -------------------- COSTS & LIMITS --------------------
# Alertas de costos de IA
AI_DAILY_COST_ALERT_USD=5.00
AI_MONTHLY_COST_LIMIT_USD=50.00

# -------------------- DEVELOPMENT --------------------
# Solo para desarrollo
DEBUG=false
LOG_LEVEL=info
PRETTY_LOGS=true

# ========================================
# NOTAS DE CONFIGURACIÓN
# ========================================
# 
# 1. ANTHROPIC_API_KEY: Obligatorio para funciones de IA
#    - Crear cuenta en: https://console.anthropic.com/
#    - Planes: Pay-as-you-go (~$1/mes para 100 cotizaciones)
# 
# 2. WAHA (WhatsApp): 
#    - Opción 1 (gratis): Instalar WAHA localmente
#    - Opción 2 (oficial): WhatsApp Business API via Twilio/MessageBird
#    - Ver documentación en docs/WHATSAPP_SETUP.md
# 
# 3. Railway Deploy:
#    - Railway auto-detecta estas variables
#    - DATABASE_URL se auto-genera
#    - PUBLIC_URL se auto-asigna
# 
# 4. Costos estimados (100 cotizaciones/mes):
#    - Claude AI: ~$1
#    - WhatsApp no oficial: $0
#    - Railway + Vercel: $0
#    - TOTAL: ~$1/mes
# 
# ========================================
